# ==============================================================
# Property Intelligence AI - Environment Variables
# ==============================================================

# OpenRouter Free LLM Configuration
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Qdrant Vector Database
# Use http://qdrant:6333 in Docker, or http://localhost:6333 for standalone local development
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=property_knowledge

# API & Networking
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Host Port Overrides (useful if ports 3000/8000/6333 are occupied by other services)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# QDRANT_PORT=6333

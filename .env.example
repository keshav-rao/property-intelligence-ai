# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Tried in order if the primary model fails or is rate-limited
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Vector store: "local" = embedded Qdrant on disk (no Docker needed).
# docker-compose overrides this with http://qdrant:6333.
QDRANT_URL=local
QDRANT_COLLECTION=property_knowledge

# Memory optimization: Set to "true" on memory-constrained hosting (e.g. Render Free 512MB RAM)
# to disable dense embeddings (FastEmbed) and use lightweight BM25 retrieval only.
DISABLE_DENSE_RETRIEVAL=false

# Browser origins allowed to call the API directly (same-origin /api calls need nothing).
CORS_ORIGINS=http://localhost:3000

{"scenario_id": "SCENARIO-01", "category": "conversation_flow", "platform": "wasalt", "title": "Wasalt Multi-turn Property Search", "turns": [{"turn_index": 1, "user_input": "I want to buy a property in Saudi Arabia.", "expected_filters": {"purpose": "sale", "country": "Saudi Arabia"}, "expected_behavior": ["route_to_wasalt", "ask_for_city"]}, {"turn_index": 2, "user_input": "Specifically in Riyadh.", "expected_filters": {"purpose": "sale", "city": "Riyadh"}, "expected_behavior": ["retain_sale_purpose", "apply_riyadh_filter"]}, {"turn_index": 3, "user_input": "I prefer an apartment.", "expected_filters": {"purpose": "sale", "city": "Riyadh", "property_type": "apartment"}, "expected_behavior": ["retain_riyadh_and_sale", "apply_apartment_filter"]}, {"turn_index": 4, "user_input": "I need three bedrooms.", "expected_filters": {"purpose": "sale", "city": "Riyadh", "property_type": "apartment", "bedrooms": 3}, "expected_behavior": ["retain_all_previous_filters", "apply_bedrooms_filter"]}, {"turn_index": 5, "user_input": "My budget is 1.2 million SAR.", "expected_filters": {"purpose": "sale", "city": "Riyadh", "property_type": "apartment", "bedrooms": 3, "budget_max": 1200000}, "expected_behavior": ["retain_all_filters", "apply_budget_max"]}, {"turn_index": 6, "user_input": "Show me the matching properties.", "expected_filters": {"purpose": "sale", "city": "Riyadh", "property_type": "apartment", "bedrooms": 3, "budget_max": 1200000}, "expected_behavior": ["return_grounded_recommendations", "respect_budget", "cite_original_urls"]}], "must_not": ["forget_riyadh", "forget_bedrooms", "recommend_properties_over_1.2m"]}
{"scenario_id": "SCENARIO-02", "category": "conversation_flow", "platform": "darglobal", "title": "DarGlobal Luxury Investment Discovery", "turns": [{"turn_index": 1, "user_input": "I'm interested in luxury real estate.", "expected_behavior": ["route_to_darglobal", "introduce_luxury_portfolio"]}, {"turn_index": 2, "user_input": "Show me projects in Dubai.", "expected_filters": {"city": "Dubai"}, "expected_behavior": ["list_dubai_projects", "mention_branded_options"]}, {"turn_index": 3, "user_input": "I prefer branded residences.", "expected_behavior": ["filter_branded_residences", "highlight_brand_partners"]}, {"turn_index": 4, "user_input": "Tell me more about the first project.", "expected_behavior": ["maintain_context_of_first_project", "provide_details"]}, {"turn_index": 5, "user_input": "Who is the brand partner?", "expected_behavior": ["identify_correct_brand_partner", "no_hallucination"]}, {"turn_index": 6, "user_input": "What amenities are mentioned?", "expected_behavior": ["cite_published_amenities"]}, {"turn_index": 7, "user_input": "Is there any published information about payment plans?", "expected_behavior": ["admit_unconfirmed_payment_plans", "avoid_hallucination"]}, {"turn_index": 8, "user_input": "How can I register my interest?", "expected_behavior": ["provide_verified_enquiry_destination"]}, {"turn_index": 9, "user_input": "Can I speak to a sales advisor?", "expected_behavior": ["guide_to_official_enquiry_form", "protect_pii"]}], "must_not": ["repeat_questions", "fabricate_payment_plans", "lose_selected_project_context"]}
{"scenario_id": "SCENARIO-03", "category": "conversation_flow", "platform": "wasalt", "title": "User Changes Their Mind & Updates Requirements", "turns": [{"turn_index": 1, "user_input": "Find me an apartment in Riyadh.", "expected_filters": {"city": "Riyadh", "property_type": "apartment"}}, {"turn_index": 2, "user_input": "My budget is 800,000 SAR.", "expected_filters": {"city": "Riyadh", "property_type": "apartment", "budget_max": 800000}}, {"turn_index": 3, "user_input": "Actually, increase it to 1 million.", "expected_filters": {"city": "Riyadh", "property_type": "apartment", "budget_max": 1000000}}, {"turn_index": 4, "user_input": "I would prefer a villa instead.", "expected_filters": {"city": "Riyadh", "property_type": "villa", "budget_max": 1000000}}, {"turn_index": 5, "user_input": "Let's look in Jeddah instead.", "expected_filters": {"city": "Jeddah", "property_type": "villa", "budget_max": 1000000}}, {"turn_index": 6, "user_input": "Show me the updated results.", "expected_filters": {"city": "Jeddah", "property_type": "villa", "budget_max": 1000000}, "expected_behavior": ["return_jeddah_villas", "do_not_return_riyadh_apartments"]}], "must_not": ["retain_old_city_riyadh", "retain_old_type_apartment", "keep_800k_cap"]}
